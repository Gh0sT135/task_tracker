<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Трекер задач{% endblock %}</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    {% block stylesheets %}{% endblock %}
</head>
<body class="d-flex flex-column min-vh-100">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" href="{{ path('task_index') }}">Трекер задач</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Переключить навигацию">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNavbar">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link{{ app.current_route == 'task_index' ? ' active' : '' }}" href="{{ path('task_index') }}">Задачи</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link{{ app.current_route == 'category_index' ? ' active' : '' }}" href="{{ path('category_index') }}">Категории</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link{{ app.current_route == 'project_index' ? ' active' : '' }}" href="{{ path('project_index') }}">Проекты</a>
                    </li>
                </ul>
                <a class="btn btn-primary" href="{{ path('task_new') }}">Новая задача</a>
            </div>
        </div>
    </nav>

    <main class="container flex-grow-1">
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Закрыть"></button>
                </div>
            {% endfor %}
        {% endfor %}

        {% block body %}{% endblock %}
    </main>

    <footer class="container mt-5 border-top pt-3 text-muted">
        &copy; {{ 'now'|date('Y') }} Лабораторная работа №3
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    {% block javascripts %}{% endblock %}
</body>
</html>
