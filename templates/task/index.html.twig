{% extends 'base.html.twig' %}

{% block title %}Список задач{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Список задач</h1>
        <a href="{{ path('task_new') }}" class="btn btn-primary">Добавить задачу</a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Название</th>
                    <th>Проект</th>
                    <th>Категория</th>
                    <th>Статус</th>
                    <th>Приоритет</th>
                    <th>Срок</th>
                    <th>Создана</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                {% for task in tasks %}
                    <tr>
                        <td>{{ loop.index }}</td>
                        <td>
                            <strong>{{ task.title }}</strong>
                            {% if task.description %}
                                <div class="small text-muted">{{ task.description }}</div>
                            {% endif %}
                        </td>
                        <td>{{ task.project.name }}</td>
                        <td>{{ task.category ? task.category.name : 'Нет категории' }}</td>
                        <td>
                            {% set statusClass = {
                                'To Do': 'secondary',
                                'In Progress': 'primary',
                                'Review': 'warning',
                                'Done': 'success',
                            } %}
                            <span class="badge text-bg-{{ statusClass[task.status.value] ?? 'secondary' }}">{{ task.status.value }}</span>
                        </td>
                        <td>
                            {% set priorityClass = {
                                'Low': 'secondary',
                                'Medium': 'info',
                                'High': 'warning',
                                'Critical': 'danger',
                            } %}
                            <span class="badge text-bg-{{ priorityClass[task.priority.value] ?? 'secondary' }}">{{ task.priority.value }}</span>
                        </td>
                        <td>{{ task.dueDate ? task.dueDate|date('d.m.Y') : '—' }}</td>
                        <td>{{ task.createdAt|date('d.m.Y H:i') }}</td>
                        <td class="text-nowrap">
                            <a href="{{ path('task_edit', {'id': task.id}) }}" class="btn btn-sm btn-outline-primary">Ред.</a>

                            <form method="post" action="{{ path('task_delete', {'id': task.id}) }}" class="d-inline-block" onsubmit="return confirm('Вы уверены, что хотите удалить запись?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ task.id) }}">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Удалить</button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="9" class="text-center text-muted">Записи не найдены</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
